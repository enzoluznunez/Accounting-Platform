# Copy this file to .env (same folder) and fill in the values. Git ignores .env,
# so what you put there stays on this machine.

# Atlas → your cluster → Connect → Drivers → Python. Replace <db_password> with
# the user's real password. Use the admin user here: load_mongo.py writes.
MONGODB_URI=mongodb+srv://USER:PASSWORD@nasba.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=nasba

# The database inside the cluster. Leave it unless you want a scratch copy.
MONGODB_DB=nasba

# The AWS login rebuild.py and the tests read the export from S3 with
# (after `aws sso login --profile nasba`).
AWS_PROFILE=nasba
